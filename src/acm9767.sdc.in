// ===========================================================================
// AUTO-GENERATED by CMake from src/acm9767.sdc.in -- DO NOT EDIT the .sdc.
// The PLL multiply/divide factors come from platform.json (pll.fbdiv / pll.idiv)
// so the timing constraints always match the clock the rPLL actually makes.
// ===========================================================================

// 27 MHz crystal on pin 52.
create_clock -name base -period @PLATFORM_SYS_CLK_PERIOD_NS@ -waveform {0 @PLATFORM_SYS_CLK_HALF_NS@} [get_ports {sys_clk}]

// DAC sample clock out of the rPLL (net dac_clk in acm9767_top):
// dac_clk = base * fbdiv / idiv = @PLATFORM_DAC_CLK_HZ@ Hz.
create_generated_clock -name dac_clk -source [get_ports {sys_clk}] -master_clock base -multiply_by @PLATFORM_PLL_FBDIV@ -divide_by @PLATFORM_PLL_IDIV@ [get_nets {dac_clk}]

// The only base <-> dac_clk crossings are the toggle-handshake synchronisers in
// cdc_commit_sync / reset_sync (2-FF chains), so the domains are asynchronous
// for STA purposes.
set_clock_groups -asynchronous -group [get_clocks {base}] -group [get_clocks {dac_clk}]

report_high_fanout_nets -max_nets 10
// Per-clock worst paths in the timing report (the default listing is global
// and only ever shows dac_clk); base first so its deepest paths are visible.
report_timing -setup -from_clock [get_clocks {base}] -to_clock [get_clocks {base}] -max_paths 60 -max_common_paths 1
report_timing -setup -from_clock [get_clocks {dac_clk}] -to_clock [get_clocks {dac_clk}] -max_paths 12 -max_common_paths 1
